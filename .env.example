# Supabase (Free tier to start, Pro $25/mo when you go live)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (free to integrate, 2.9% + $0.30 per transaction)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=

# Anthropic API — powers the in-app chat bot (Claude Haiku 4.5)
ANTHROPIC_API_KEY=

# Music partner API — fill in once a licensing agreement is signed
# (Epidemic Sound Partner API / Artlist / Soundstripe)
MUSIC_PROVIDER_API_KEY=
MUSIC_PROVIDER_BASE_URL=

# Remotion Lambda (for production-quality rendering; leave blank to render locally)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_FUNCTION_NAME=

# Admin panel (full access to users, plans, and the template catalog)
ADMIN_EMAIL=admin@kraft.app
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
